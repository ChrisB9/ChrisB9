---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Journey from '../../components/Journey.astro';
import TechStack from '../../components/TechStack.astro';
import WorkList from '../../components/WorkList.astro';
import portraitImage from '../../assets/images/frame-1.png';
import { LOCALES, type Locale } from '../../i18n/ui';
import { ageFrom, useTranslations } from '../../i18n/utils';
import { emailPlaceholder } from '../../lib/email';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const bySlug = new Map<string, Map<string, (typeof pages)[number]>>();

  for (const entry of pages) {
    const [locale, slug] = entry.id.split('/');
    if (!locale || !slug || !(LOCALES as readonly string[]).includes(locale)) continue;
    if (entry.data.draft) continue;
    if (!bySlug.has(slug)) bySlug.set(slug, new Map());
    bySlug.get(slug)!.set(locale, entry);
  }

  return [...bySlug.entries()].flatMap(([slug, byLocale]) =>
    LOCALES.map((locale) => {
      const entry = byLocale.get(locale) ?? byLocale.get('en');
      if (!entry) return null;
      return {
        params: { locale, slug },
        props: { entry, translated: byLocale.has(locale) },
      };
    }).filter((p) => p !== null),
  );
}

const { entry, translated } = Astro.props;
const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);

const age = ageFrom(site.birth.year, site.birth.month, site.birth.day);
const html = (entry.rendered?.html ?? '')
  .replaceAll('{age}', String(age))
  .replaceAll('{email}', emailPlaceholder);
---

<Base
  locale={locale}
  slug={Astro.params.slug!}
  title={entry.data.title}
  description={entry.data.description}
  noindex={entry.data.noindex}
>
  <p class="eyebrow">{site.name}</p>
  <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl" style="text-wrap: balance">
    {entry.data.title}
  </h1>

  {entry.data.portrait && (
    <Image
      src={portraitImage}
      alt={site.author}
      width={448}
      height={448}
      densities={[1, 2]}
      class="mx-auto mt-8 h-56 w-56 rounded-full object-cover shadow-lg"
      style="object-position: 50% 46%"
      loading="eager"
    />
  )}

  {!translated && (
    <p
      lang="en"
      class="mt-6 rounded-lg border border-line bg-surface px-4 py-3 text-sm text-ink-soft"
    >
      {t('untranslated')}
    </p>
  )}

  <div class="prose-page mt-8" lang={translated ? undefined : 'en'} set:html={html} />

  {entry.data.sections.includes('stack') && <TechStack locale={locale} />}
  {entry.data.sections.includes('timeline') && (
    <Journey locale={locale} moveLabel={t('journey.move')} title={t('journey.title')} />
  )}
  {entry.data.sections.includes('work') && <WorkList locale={locale} />}
</Base>
