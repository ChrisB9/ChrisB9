---
import Base from '../../layouts/Base.astro';
import WorldMap from '../../components/WorldMap.astro';
import LangSwitcher from '../../components/LangSwitcher.astro';
import ReadingToggle from '../../components/ReadingToggle.astro';
import { LOCALES, type Locale } from '../../i18n/ui';
import { localePath, useTranslations } from '../../i18n/utils';
import { site, social } from '../../data/site';
import { emailAttrs } from '../../lib/email';
import { countryName } from '../../lib/world';
import visited from '../../data/visited.json';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);

const destinations = ['about', 'work', 'cv'] as const;
const here = countryName(visited.current, locale);
const total = visited.lived.length + visited.visited.length;
---

<Base locale={locale} slug="" title={site.author} description={t('index.positioning')} full>
  <div class="relative isolate min-h-[100svh] overflow-hidden">
    <div class="pointer-events-none absolute inset-0 grid place-items-center">
      <WorldMap locale={locale} label={t('index.map.label')} class="h-full w-full" />
    </div>

    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-canvas/60 via-transparent to-canvas/70"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 flex min-h-[100svh] flex-col justify-between gap-12 p-6 sm:p-10">
      <header class="flex flex-wrap items-start justify-between gap-6">
        <div>
          <p class="eyebrow">{site.name}</p>
          <h1
            class="mt-2 text-3xl font-semibold tracking-tight sm:text-5xl"
            style="text-wrap: balance"
          >
            {site.author}
          </h1>
          <p class="mt-3 max-w-md text-ink-soft" style="text-wrap: pretty">
            {t('index.positioning')}
          </p>
        </div>

        <div class="flex items-center gap-2">
          <ReadingToggle locale={locale} />
          <LangSwitcher locale={locale} slug="" />
        </div>
      </header>

      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-8">
        <nav aria-label={t('nav.menu')}>
          <ul class="flex flex-col gap-2">
            {destinations.map((key) => (
              <li>
                <a
                  href={localePath(locale, key)}
                  class="group inline-flex items-center gap-3 text-xl transition-colors hover:text-primary sm:text-2xl"
                >
                  <span
                    aria-hidden="true"
                    class="h-1.5 w-1.5 rounded-full bg-ink-mute transition-colors group-hover:bg-primary"
                  />
                  {t(`nav.${key}` as const)}
                </a>
              </li>
            ))}
          </ul>

          <ul class="mt-6 flex flex-wrap gap-x-4 gap-y-1 text-sm text-ink-mute">
            {social.map((item) => (
              <li>
                <a
                  href={item.id === 'email' ? undefined : item.url}
                  class="transition-colors hover:text-primary"
                  {...(item.id === 'email' ? emailAttrs : { target: '_blank', rel: 'me noopener' })}
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li>
              <a href={localePath(locale, 'imprint')} class="transition-colors hover:text-primary">
                {t('footer.imprint')}
              </a>
            </li>
          </ul>
        </nav>

        <dl class="flex flex-col gap-1.5 font-mono text-xs text-ink-mute">
          <div class="flex items-center gap-2">
            <span aria-hidden="true" class="h-2.5 w-2.5 rounded-sm bg-primary"></span>
            <dt>{t('index.map.lived')}</dt>
            <dd class="tabular-nums">{visited.lived.length}</dd>
          </div>
          <div class="flex items-center gap-2">
            <span aria-hidden="true" class="h-2.5 w-2.5 rounded-sm bg-visited"></span>
            <dt>{t('index.map.visited')}</dt>
            <dd class="tabular-nums">{visited.visited.length}</dd>
          </div>
          <p class="mt-1.5 border-t border-line pt-1.5">{t('index.map.countries', { n: total })}</p>
          <p class="text-primary">{t('index.map.here', { country: here })}</p>
        </dl>
      </div>
    </div>
  </div>
</Base>
