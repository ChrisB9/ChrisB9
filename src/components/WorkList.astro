---
import type { Locale } from '../i18n/ui';
import { localePath, useTranslations } from '../i18n/utils';
import projects from '../data/projects.json';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

type Entry = (typeof projects)[number];

const items = projects.filter((p) => !('hidden' in p && p.hidden));

const link = (p: Entry) => ('internal' in p && p.internal ? localePath(locale, p.internal) : null);
const primary = (p: Entry) => link(p) ?? p.url ?? p.source ?? null;
const source = (p: Entry) => (p.source && p.source !== primary(p) ? p.source : null);
const external = (p: Entry) => !link(p);
const text = (p: Entry, field: 'title' | 'description') =>
  (p[field] as Record<string, string>)[locale] ?? (p[field] as Record<string, string>).en;

const bullets = (p: Entry): string[] => {
  if (!('bullets' in p) || !p.bullets) return [];
  const b = p.bullets as Record<string, string[]>;
  return b[locale] ?? b.en ?? [];
};

const filters = [
  { key: 'all', label: t('work.all') },
  { key: 'client', label: t('work.client') },
  { key: 'own', label: t('work.own') },
] as const;

const byPin = (a: Entry, b: Entry) =>
  Number('pinned' in b && b.pinned) - Number('pinned' in a && a.pinned);

const groups = [
  { key: 'active', label: t('work.active'), items: items.filter((p) => p.active).sort(byPin) },
  { key: 'past', label: t('work.past'), items: items.filter((p) => !p.active).sort(byPin) },
];
---

<div data-work>
  <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2" role="group" aria-label={t('work.filter')}>
    {filters.map((f) => (
      <li>
        <button
          type="button"
          data-filter={f.key}
          aria-pressed={f.key === 'all' ? 'true' : 'false'}
          class="group inline-flex items-center gap-2 text-sm text-ink-soft transition-colors aria-pressed:text-ink hover:text-primary"
        >
          <span
            aria-hidden="true"
            class="h-1.5 w-1.5 rounded-full bg-transparent transition-colors group-aria-pressed:bg-primary"
          />
          {f.label}
        </button>
      </li>
    ))}
  </ul>

  {groups.map((group) => (
    <section data-group={group.key} class="mt-12">
      <h2 class="eyebrow">{group.label}</h2>
      <ul class="mt-5 flex flex-col gap-7">
        {group.items.map((p) => (
          <li data-kind={p.client ? 'client' : 'own'} class="flex flex-col gap-1.5">
            <h3 class="flex items-baseline gap-3 text-lg font-medium">
              <span
                aria-hidden="true"
                class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-ink-mute"
              />
              {primary(p) ? (
                <a
                  href={primary(p)!}
                  class="underline decoration-line decoration-1 underline-offset-4 transition-colors hover:text-primary hover:decoration-primary"
                  {...(external(p) ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {text(p, 'title')}
                </a>
              ) : (
                text(p, 'title')
              )}

              {source(p) && (
                <a
                  href={source(p)!}
                  target="_blank"
                  rel="noopener"
                  class="font-mono text-[0.68rem] font-normal text-ink-mute underline decoration-line underline-offset-4 transition-colors hover:text-primary"
                >
                  {t('work.source')}
                </a>
              )}

              {!primary(p) && (
                <span class="font-mono text-[0.68rem] font-normal text-ink-mute">
                  {t('work.notPublic')}
                </span>
              )}
            </h3>

            <div class="flex flex-col gap-2 pl-[1.125rem]">
              <p
                class="max-w-prose text-sm leading-relaxed text-ink-soft"
                set:html={text(p, 'description')}
              />
              {bullets(p).length > 0 && (
                <ul class="max-w-prose list-disc space-y-1 pl-5 text-sm leading-relaxed text-ink-soft">
                  {bullets(p).map((b: string) => (
                    <li>{b}</li>
                  ))}
                </ul>
              )}
              {p.tags?.length > 0 && (
                <ul class="flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs text-ink-mute">
                  {p.tags.map((tag: string) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-work]');
  if (root) {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = root.querySelectorAll<HTMLElement>('[data-kind]');
    const groups = root.querySelectorAll<HTMLElement>('[data-group]');

    const apply = (filter: string) => {
      for (const item of items) {
        item.hidden = filter !== 'all' && item.dataset.kind !== filter;
      }

      for (const group of groups) {
        group.hidden = [...group.querySelectorAll<HTMLElement>('[data-kind]')].every(
          (i) => i.hidden,
        );
      }
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
      }
    };

    for (const button of buttons) {
      button.addEventListener('click', () => apply(button.dataset.filter ?? 'all'));
    }

    const fromHash = location.hash.replace('#', '');
    const valid = [...buttons].some((b) => b.dataset.filter === fromHash);
    const pressed = root.querySelector<HTMLButtonElement>('[aria-pressed="true"]');
    apply(valid ? fromHash : (pressed?.dataset.filter ?? 'all'));

    window.addEventListener('hashchange', () => {
      const next = location.hash.replace('#', '');
      if ([...buttons].some((b) => b.dataset.filter === next)) apply(next);
    });
  }
</script>
